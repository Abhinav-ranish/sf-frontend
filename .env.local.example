# Copy to .env.local and adjust. Only NEXT_PUBLIC_* vars reach the browser.

# Contacts API base URL. Read on the server only (server components + server
# actions), so it is never exposed to the browser and CORS never applies.
API_BASE_URL=http://127.0.0.1:8000

# How long to wait for the API before showing the "unreachable" panel.
# API_TIMEOUT_MS=8000

# Stable server-side secret used to seal nearby encounter tokens.
# Required in production; generate one with: openssl rand -base64 32
# NEARBY_TOKEN_SECRET=

# Optional: base URL for the rare fetch made from a client component. Leave unset
# in production so those requests stay same-origin behind the proxy.
# NEXT_PUBLIC_API_BASE_URL=

# Version stamp overrides. Normally derived in next.config.ts from package.json +
# git, so you only set these in CI.
# NEXT_PUBLIC_APP_VERSION=0.1.0
# NEXT_PUBLIC_BUILD_NUMBER=42
# NEXT_PUBLIC_GIT_SHA=abc1234

# E2E: point Playwright at an already-running server instead of letting it start one.
# E2E_BASE_URL=http://localhost:3000
